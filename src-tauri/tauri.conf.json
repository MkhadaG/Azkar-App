{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Azkar",
  "version": "0.4.11",
  "identifier": "com.azkar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Azkar",
        "width": 1100,
        "height": 720,
        "minWidth": 420,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "noRedirectionBitmap": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420 https://api.alquran.cloud https://geocoding-api.open-meteo.com; img-src 'self' data: blob: https://raw.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5QzcwMTlCOTMyRTk5MzcKUldRM21TNlRtd0hINlVaejQweFJDU3Jsd29DN2xIWkRoTmlPSFJVM2Qyd0ZQNWxtVjRhOFhtMlQK",
      "endpoints": [
        "https://github.com/MkhadaG/Azkar-App/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
